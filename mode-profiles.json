          },
          {
            "query_type": [
              "HTTPS"
            ],
            "server": "dns-remote"
          },
          {
            "query_type": [
              "TXT",
              "MX"
            ],
            "server": "dns-remote"
          }
        ],
        "final": "dns-bootstrap",
        "strategy": "prefer_ipv4",
        "background_resolve": false
      }
    },
    "route_rules_prepend": [
      {
        "port": 443,
        "network": [
          "udp"
        ],
        "action": "reject"
      }
    ],
    "route_shaping": {
      "keep_route_outbound": [
        "direct-out"
      ],
      "final": "proxy"
