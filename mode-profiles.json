{
  "rule": {
    "route_rules_prepend": [
      {
        "port": 443,
        "network": [
          "udp"
        ],
        "action": "reject"
      },
      {
        "port": 53,
        "action": "hijack-dns"
      },
      {
        "ip_is_private": true,
        "outbound": "direct-out"
      },
      {
        "geosite": [
          "category-ai-!cn"
