          {
            "type": "fakeip",
            "tag": "dns-fakeip",
            "inet4_range": "198.18.0.0/15",
            "inet6_range": "fc00::/64"
          }
        ],
        "rules": [
          {
            "geosite": [
              "cn"
            ],
            "server": "default-dns"
          },
          {
            "domain": [
              "dns.msftnsci.com",
              "www.msftnsci.com",
              "www.msftconnecttest.com"
            ],
            "server": "default-dns"
          },
          {
            "geosite": [
              "cn"
            ],
            "invert": true,
            "server": "dns-remote"
          },
          {
            "query_type": [
              "A",
              "AAAA"
            ],
            "server": "dns-fakeip"
          },
          {
            "query_type": [
              "HTTPS"
            ],
            "server": "dns-remote"
          }
        ],
        "final": "default-dns",
        "strategy": "prefer_ipv4"
      }
    }
  },
  "global": {
    "replace_sections": {
      "dns": {
        "servers": [
          {
            "type": "fakeip",
            "tag": "dns-fakeip",
            "inet4_range": "198.18.0.0/15",
            "local_answers_only": true
          },
          {
            "type": "udp",
            "tag": "dns-bootstrap",
            "server": "223.5.5.5",
