        "outbound": "kiss-exit-nohk"
      },
      {
        "domain_suffix": [
          "deepseek.com"
        ],
        "outbound": "direct-out"
      },
      {
        "geosite": [
          "google",
          "github",
          "gfw",
          "telegram"
        ],
        "outbound": "kiss-exit"
      },
      {
        "geoip": [
          "telegram"
        ],
        "outbound": "kiss-exit"
      },
      {
        "geosite": [
          "cn"
        ],
        "outbound": "direct-out"
      },
      {
        "geoip": [
          "cn"
        ],
        "outbound": "direct-out"
      }
